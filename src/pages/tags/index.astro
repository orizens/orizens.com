---
import type { IFrontmatter } from 'astro-boilerplate-components';

import PageSection from '@/components/PageSection.astro';
import Base from '@/templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';
import { countTags } from '@/utils/Posts';

const allPosts = await Astro.glob<IFrontmatter>('../blog/*.md');
const allTags = countTags(allPosts);
const allTagsSorted = Object.entries(allTags).sort(
  (a: any[], b: any[]) => (b[1] as number) - (a[1] as number)
);

const title = `Article tags - ${AppConfig.site_name}`;
const { description } = AppConfig;
---

<Base head={{ title, description, og: { image: '/images/galaxy-map.jpg' } }}>
  <PageSection class='!pb-4 lg:!pb-6'>
    <h1
      class='font-display-xl text-ink-primary'
      style='font-size:clamp(2.6rem,6vw,4.5rem)'
    >
      Browse by <span class='brand-text'>tag</span>
    </h1>
    <p class='mt-4 max-w-2xl text-lg text-ink-secondary'>
      Every topic I&rsquo;ve written about, most-covered first.
    </p>
  </PageSection>

  <PageSection class='!pt-0'>
    <ul class='flex flex-wrap gap-3'>
      {
        allTagsSorted.map(([tagName, total]) => (
          <li>
            <a
              href={`/tags/${tagName}/`}
              class='c-card flex items-center gap-2 px-4 py-2 text-ink-secondary hover:text-ink-primary'
            >
              <span class='h-1.5 w-1.5 rounded-full bg-brand' aria-hidden='true' />
              <span class='font-medium'>{tagName}</span>
              <span class='text-sm text-ink-muted'>{total as number}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </PageSection>
</Base>
