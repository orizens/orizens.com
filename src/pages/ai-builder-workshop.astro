    /* Problem cards carry a soft cyan→violet gradient as their surface. */
    .problem-card {
      background: radial-gradient(
        circle at 30% 25%,
        rgba(41, 198, 255, 0.28),
        rgba(128, 102, 255, 0.16)
      );
    }

    .step-badge {
