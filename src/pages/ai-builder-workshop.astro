    /* Process cards: radial wash tinted per step, centered on the top-left
       corner so the glow trails down from behind the step number. */
    .process-card {
      background:
        radial-gradient(
          circle at top left,
          color-mix(in srgb, var(--tint) 24%, transparent),
          transparent 62%
        ),
        rgba(6, 18, 38, 0.55);
    }

    /* Shiny shadow halo behind every icon. A blurred tinted disc sits behind
       the glyph, and the glyph itself gets a matching bloom drop-shadow. */
    .icon-halo {
      --tint: #5fd3ff;
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      isolation: isolate;
