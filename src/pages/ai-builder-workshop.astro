    .icon-halo::before {
      content: '';
      position: absolute;
      inset: -38%;
      z-index: -1;
      border-radius: 9999px;
      background: radial-gradient(
        circle,
        color-mix(in srgb, var(--tint) 60%, transparent) 0%,
        color-mix(in srgb, var(--tint) 22%, transparent) 42%,
        transparent 70%
      );
      filter: blur(12px);
    }

    .icon-halo > svg {
      filter:
        drop-shadow(0 0 6px color-mix(in srgb, var(--tint) 75%, transparent))
        drop-shadow(0 2px 10px color-mix(in srgb, var(--tint) 45%, transparent));
    }

    /* Small hover lift on cards. */
    .lift {
      transition:
        transform 0.22s ease,
        border-color 0.22s ease,
        box-shadow 0.22s ease;
    }

    .lift:hover {
      transform: translateY(-4px);
