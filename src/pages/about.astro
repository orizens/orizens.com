---
import avatar from '@/assets/avatar.png';
import Check from '@/components/Check.astro';
import PageSection from '@/components/PageSection.astro';
import ContactCTA from '@/partials/ContactCTA.astro';
import OpenSource from '@/partials/OpenSource.astro';
import Press from '@/partials/Press.astro';
import SelectedWork from '@/partials/SelectedWork.astro';
import { Socials } from '@/partials/Socials';
import TechStackStrip from '@/partials/TechStackStrip.astro';
import Base from '@/templates/Base.astro';

const description = `Oren Farhi — an experienced Software Engineer, Front End Engineer, Front End Architect and Tech Lead, focused on software architecture and well-formed applications.`;

const principles = [
  {
    title: 'Simple beats clever.',
    text: 'I break big, tangled problems into small pieces that anyone on the team can read, test and change.',
  },
  {
    title: 'Architecture is a team sport.',
    text: 'Good structure should make the next developer faster, not more confused.',
  },
  {
    title: 'Speed is a feature.',
    text: "I've cut build times with Vite and Bun and shortened CI runs for unit and E2E tests, because slow feedback quietly drains a team.",
  },
  {
    title: 'Ship safely.',
    text: 'Feature flags, solid test coverage and CI/CD pipelines let teams release often without holding their breath.',
  },
  {
    title: 'AI as a teammate, not a shortcut.',
    text: 'I use AI coding agents every day, and I help teams adopt them in a way that raises quality instead of just raising output.',
  },
];

const advisory = [
  {
    title: 'Technical leadership on demand:',
    text: 'architecture reviews and audits of code, security and infrastructure',
  },
  {
    title: 'Keeping agencies honest:',
    text: 'overseeing external dev shops and contractors so founders know what they\'re paying for',
  },
  {
    title: 'AI-augmented development:',
    text: 'setting up workflows where AI agents speed teams up without cutting corners',
  },
  {
    title: 'Getting investor-ready:',
    text: 'pitch decks, plus advice on how to approach conversations with investment firms',
  },
];
---

<Base head={{ title: 'About Oren Farhi', description, og: { image: '/images/profile.png' } }}>
  {/* Hero — reuses the home page's full-bleed cosmic artwork (public/images/header-new.png),
      pulled up behind the transparent site header, with the intro copy on the darker
      left side and Oren's 3D avatar floating on the moon to the right. */}
  <section class='relative isolate -mt-[4.75rem] overflow-hidden'>
    <div class='pointer-events-none absolute inset-0 -z-10' aria-hidden='true'>
      <img
        src='/images/header-new.png'
        alt=''
        loading='eager'
        fetchpriority='high'
        class='h-full w-full object-cover object-[68%_center]'
      />
    </div>

    <div
      class='relative mx-auto flex min-h-[clamp(30rem,72vh,40rem)] max-w-content flex-col justify-center px-5 pb-16 pt-28 sm:px-6 lg:px-10 lg:pb-20 lg:pt-36 xl:px-12'
    >
      <div class='max-w-2xl w-full max-w-xl rounded-3xl border border-cool bg-cosmic-900/60 p-6 sm:p-8'>
        <p class='text-xs font-semibold uppercase tracking-[0.32em] text-ink-muted'>
          About
        </p>
        <h1
          class='mt-5 font-display-xl text-ink-primary'
          style='font-size:clamp(2.6rem,6vw,4.5rem)'
        >
          <span class='brand-text'>Oren Farhi</span>
        </h1>
        <p class='mt-4 text-lg font-medium text-ink-secondary sm:text-xl'>
          Senior Front End Engineer <span class='text-ink-subtle'>·</span> Tech Lead
        </p>
        <div class='mt-6'>
          <Socials />
        </div>
      </div>
    </div>

    {/* Floating 3D avatar — on the moon, right of the copy */}
    <div
      class='pointer-events-none z-0 items-end sm:relative sm:right-[50%] md:absolute md:bottom-6 md:right-[21%] lg:flex lg:right-[23%] xl:bottom-[62px] xl:right-[24%]'
      aria-hidden='true'
    >
      <div class='grid items-center justify-items-end sm:relative'>
        <div
          class='absolute left-1/2 top-[46%] h-[72%] w-[72%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(41,198,255,0.28),transparent_65%)] blur-2xl motion-safe:animate-glow-breathe'
        >
        </div>
        <img
          src={avatar.src}
          width={avatar.width}
          height={avatar.height}
          alt='Oren Farhi — 3D avatar'
          loading='eager'
          class='relative h-[26rem] w-auto drop-shadow-[0_22px_45px_rgba(0,0,0,0.5)] motion-safe:animate-float-soft'
        />
      </div>
    </div>
  </section>

  <PageSection class='!py-6 lg:!py-8'>
    <div class='c-card space-y-4 p-6 text-base leading-relaxed text-ink-secondary sm:p-8 sm:text-lg'>
      <p>
        I&rsquo;ve been building for the web for over 20 years, and I still get
        a kick out of the moment a messy problem turns into something simple.
      </p>
      <p>
        I&rsquo;m <strong class='text-ink-primary'>self-taught at heart</strong>.
        I started by taking things apart to see how they worked, and later
        earned a
        <strong class='text-ink-primary'>BA in Computer Science &amp; Business Management</strong>
        from the Open University. That mix still shapes how I work. I care about
        clean architecture, and I also care whether what we&rsquo;re building
        actually moves the business.
      </p>
      <p>
        Most recently I&rsquo;ve led front end work at companies like Zscaler,
        HighRes BioSolutions, Rivery and 1Care.ai. The products ranged from
        security platforms and lab automation software to data pipelines and
        healthcare. Along the way I wrote
        <em>Reactive Programming with Angular and NgRx</em> (Apress), created
        <a class='text-orbit-400' href='//github.com/orizens/ngx-infinite-scroll' target='_blank' rel='noopener noreferrer'>ngx-infinite-scroll</a>,
        which teams around the world rely on, and co-founded ReadM, an
        AI-powered reading fluency platform for kids.
      </p>
      <p>
        These days I split my time between two things I love: leading
        engineering teams, and helping founders build the right product the
        right way.
      </p>
    </div>
  </PageSection>

  <PageSection title='How I <span class="brand-text">work</span>' class='!py-6 lg:!py-8'>
    <div class='c-card p-6 sm:p-8'>
      <ul class='space-y-3'>
        {
          principles.map((p) => (
            <li class='flex items-start gap-3 text-ink-secondary'>
              <Check />
              <span>
                <strong class='text-ink-primary'>{p.title}</strong> {p.text}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </PageSection>

  <PageSection title='For teams and <span class="brand-text">founders</span>' class='!py-6 lg:!py-8'>
    <div class='c-card p-6 sm:p-8'>
      <p class='mb-4 text-ink-secondary'>
        Besides my engineering roles, I work as an advisor and consultant to
        startups. That usually means:
      </p>
      <ul class='space-y-3'>
        {
          advisory.map((p) => (
            <li class='flex items-start gap-3 text-ink-secondary'>
              <Check />
              <span>
                <strong class='text-ink-primary'>{p.title}</strong> {p.text}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </PageSection>

  <SelectedWork />
  <TechStackStrip />
  <OpenSource />
  <Press />
  <ContactCTA />
</Base>
