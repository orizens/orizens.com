---
import PageSection from '@/components/PageSection.astro';
import { Input } from '@/components/Input';
import { RunInClient } from '@/components/RunInClient';
import { Socials } from '@/partials/Socials';
import Base from '@/templates/Base.astro';

const SUBMIT_PARAM = 'success';
const description =
  'Contact Oren Farhi about software engineering, front end architecture, React and tech leadership.';
---

<Base
  head={{
    title: 'Contact Oren Farhi',
    description,
    og: { image: '/images/profile.png' },
  }}
>
  <PageSection class='!pb-4 lg:!pb-6'>
    <p class='text-xs font-semibold uppercase tracking-[0.32em] text-ink-muted'>
      Contact
    </p>
    <h1
      class='mt-4 font-display-xl text-ink-primary'
      style='font-size:clamp(2.6rem,6vw,4.5rem)'
    >
      Let&rsquo;s <span class='brand-text'>Connect</span>
    </h1>
    <p class='mt-4 max-w-2xl text-lg text-ink-secondary'>
      Have an idea, a question, or just want to say hi? Send a message and I&rsquo;ll
      get back to you as soon as I can.
    </p>
    <div class='mt-5'>
      <Socials />
    </div>
  </PageSection>

  <PageSection class='!pt-0'>
    <RunInClient client:only='react' param={SUBMIT_PARAM}>
      <div class='c-card p-6 sm:p-8'>
        <p class='brand-text text-2xl font-semibold'>
          Thank you for reaching out.
        </p>
        <p class='mt-2 text-ink-secondary'>
          I&rsquo;ll get back to you as soon as I can.
        </p>
        <a href='/contact/' class='mt-4 inline-block text-orbit-400'>← Back to contact</a>
      </div>

      <div slot='fallback' class='c-card p-6 sm:p-8'>
        <form
          name='contact'
          method='POST'
          action={`/contact?${SUBMIT_PARAM}`}
          data-netlify='true'
          class='grid gap-5'
        >
          <input type='hidden' name='form-name' value='contact' />
          <Input label='Your name' htmlFor='name' placeholder='Your name' />
          <Input label='Your email' htmlFor='email' type='email' placeholder='you@example.com' />
          <Input
            label='Your message'
            htmlFor='message'
            placeholder='Tell me about it…'
            type='textarea'
            rows='6'
          />
          <button type='submit' class='c-btn c-btn-primary w-full sm:w-auto'>
            Send message
          </button>
        </form>
      </div>
    </RunInClient>
  </PageSection>
</Base>
