---
/**
 * Hero — full-bleed cosmic scene (public/images/header-new.png). The artwork is
 * pulled up behind the transparent site header so it doubles as the top-menu
 * background, and the intro copy is overlaid on the darker left side of the
 * image. Oren's 3D avatar (src/assets/avatar.png) floats back on top of the
 * scene, standing on the moon by the signpost on the right.
 */
import avatar from '@/assets/avatar.png';

const RocketIcon =
  '<path d="M5 13c-1.5 1.5-2 5-2 5s3.5-.5 5-2M9 15l-3-3M14.5 4.5c2.5-1 5 0 5 0s1 2.5 0 5c-1.4 3.5-5.5 7-8 8l-5-5c1-2.5 4.5-6.6 8-8Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="14" cy="9" r="1.6" fill="currentColor"/>';
const DocIcon =
  '<path d="M7 3h7l5 5v13H7z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 3v5h5M10 13h6M10 17h6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>';
---

<section class='relative isolate -mt-[4.75rem] overflow-hidden'>
  {/* Full-bleed background artwork — spans up under the sticky header */}
  <div class='pointer-events-none absolute inset-0 -z-10' aria-hidden='true'>
    <img
      src='/images/header-new.png'
      alt=''
      loading='eager'
      fetchpriority='high'
      class='h-full w-full object-cover object-[70%_center]'
    />
    {/* Readability scrim — heaviest on the left, where the copy sits */}
    <!-- <div
      class='absolute inset-0 bg-[linear-gradient(90deg,rgba(2,8,23,0.78)_0%,rgba(2,8,23,0.55)_32%,rgba(2,8,23,0.22)_60%,rgba(2,8,23,0)_100%)]'
    >
    </div> -->
    {/* Vertical fade so the hero blends into the section below */}
    <!-- <div class='absolute inset-0 bg-gradient-to-b from-cosmic-950/20 via-transparent to-cosmic-950'></div> -->
  </div>

  <div
    class='relative mx-auto flex min-h-[clamp(34rem,84vh,46rem)] max-w-content flex-col justify-center px-5 pb-16 pt-28 sm:px-6 lg:px-10 lg:pb-24 lg:pt-36 xl:px-12'
  >
    <div class='md:max-w-2xl w-full max-w-xl rounded-3xl border border-cool bg-cosmic-900/80 p-6 sm:p-8'>
      <p
        class='text-xs font-semibold uppercase tracking-[0.32em] text-ink-muted'
      >
        Turning ideas into meaningful products
      </p>

      <h1
        class='font-display-xl mt-5 text-ink-primary'
        style='font-size:clamp(2.9rem,7.2vw,5.75rem)'
      >
        Hi, I&rsquo;m <span class='brand-text'>Oren</span>
      </h1>

      <p class='mt-4 text-lg font-medium text-ink-secondary sm:text-xl'>
        Software Engineer <span class='text-ink-subtle'>·</span> Front End Tech Lead
        <span class='text-ink-subtle'>·</span> Product Builder
      </p>

      <p
        class='mt-6 max-w-xl text-base leading-relaxed text-ink-secondary sm:text-lg'
      >
        I turn ideas into meaningful products — combining technology, software
        architecture and human insight to solve real problems and make life a
        little better for people.
      </p>

      <div class='mt-8 flex flex-col gap-3 sm:flex-row sm:items-center'>
        <a href='/#work' class='c-btn c-btn-primary w-full sm:w-auto'>
          <svg
            viewBox='0 0 24 24'
            class='h-5 w-5'
            fill='none'
            set:html={RocketIcon}></svg>
          Explore my work
        </a>
        <a href='/blog/' class='c-btn c-btn-secondary w-full sm:w-auto'>
          <svg
            viewBox='0 0 24 24'
            class='h-5 w-5'
            fill='none'
            set:html={DocIcon}></svg>
          Read my writing
        </a>
      </div>

      <p class='hand mt-8 text-2xl text-ink-secondary'>
        Better tools.<br />Happier people.
      </p>
    </div>
  </div>

    {/* Floating 3D avatar — back on the moon, right of the copy */}
  <div
    class='pointer-events-none sm:right-[50%] sm:relative md:absolute md:bottom-6 md:right-[21%] z-0 x-bottom-[230px] xright-[40%] items-end lg:flex lg:right-[23%] xl:bottom-[62px] xl:right-[24%]'
    aria-hidden='true'
  > 
    <div class='sm:relative grid justify-items-end items-center'>
      <div
        class='absolute left-1/2 top-[46%] h-[72%] w-[72%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(41,198,255,0.28),transparent_65%)] blur-2xl motion-safe:animate-glow-breathe'
      >
      </div>
      <img
        src={avatar.src}
        width={avatar.width}
        height={avatar.height}
        alt=''
        loading='eager'
        class='relative h-[26rem] w-auto drop-shadow-[0_22px_45px_rgba(0,0,0,0.5)] motion-safe:animate-float-soft h-[30rem]'
      />
    </div>
  </div>
</section>
