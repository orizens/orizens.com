---

<PageSection id='press' title='Press &amp; <span class="brand-text">Mentions</span>' icon={quoteIcon}>
  <div class='c-card overflow-x-auto'>
    <table class='w-full min-w-[36rem] border-collapse text-left'>
      <thead>
        <tr class='border-b border-cool'>
          <th class='px-5 py-3 text-sm font-medium text-ink-muted sm:px-6'>Publication</th>
          <th class='px-5 py-3 text-sm font-medium text-ink-muted sm:px-6'>Mentions</th>
        </tr>
      </thead>
      <tbody class='divide-y divide-cool'>
        {
          mentions.map((pub) => (
            <tr>
              <td class='px-5 py-4 align-top font-semibold text-ink-primary sm:px-6'>{pub.name}</td>
              <td class='px-5 py-4 sm:px-6'>
                <div class='flex flex-wrap gap-2'>
                  {pub.links.map((link) => (
                    <a
                      href={link.href}
                      target='_blank'
                      rel='noopener noreferrer'
                      class='inline-flex items-center gap-1 rounded-full border border-cool bg-cosmic-800/60 px-3 py-1 text-sm text-ink-secondary transition-colors hover:border-orbit-400/60 hover:text-orbit-300'
                    >
                      {link.label}
                      <span aria-hidden='true'>↗</span>
                    </a>
                  ))}
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</PageSection>
