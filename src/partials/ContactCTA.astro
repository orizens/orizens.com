---
const mailIcon =
  '<rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m3 7 9 6 9-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>';
const githubIcon =
  '<path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" fill="currentColor"/>';
const linkedinIcon =
  '<path d="M6.94 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM3.5 8.5h3v12h-3v-12ZM9 8.5h2.88v1.64h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.6 2 3.6 4.6v6.32h-3v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96v5.7H9v-12Z" fill="currentColor"/>';
---

<section
  class='relative mx-auto mt-10 max-w-content px-5 sm:px-6 lg:px-10 xl:px-12'
>
  <div class='relative overflow-hidden rounded-5xl border border-cool'>
    <img
      src='/images/footer.png'
      alt=''
      aria-hidden='true'
      loading='lazy'
      class='absolute inset-0 h-full w-full object-cover object-center'
    />
    <div class='bg-cosmic-950/72 absolute inset-0'></div>
    <div
      class='absolute inset-0 bg-gradient-to-t from-cosmic-950 via-cosmic-950/40 to-cosmic-950/70'
    >
    </div>

    <div
      class='relative flex flex-col items-center gap-8 p-8 text-center sm:p-12 lg:p-16'
    >
      <p class='hand text-2xl text-ink-secondary'>
        Technology is more meaningful<br />when it helps people.
      </p>

      <div
        class='w-full max-w-xl rounded-3xl border border-cool bg-cosmic-900/60 p-6 sm:p-8'
      >
        <h2 class='font-display text-[1.75rem] text-ink-primary sm:text-4xl'>
          Let&rsquo;s Build Something Meaningful
        </h2>
        <p class='mt-3 text-ink-secondary'>
          Have an idea, a question, or just want to say hi? I&rsquo;d love to
          hear from you.
        </p>

        <a
          href='/contact/'
          class='c-btn c-btn-primary mt-6 w-full sm:w-auto'
        >
          <svg
            viewBox='0 0 24 24'
            class='h-5 w-5'
            fill='none'
            set:html={mailIcon}></svg>
          Let&rsquo;s Connect
        </a>

        <div class='mt-6 flex justify-center gap-2'>
          <a
            href='//github.com/orizens'
            target='_blank'
            rel='noopener noreferrer'
            aria-label='GitHub'
            class='flex h-11 w-11 items-center justify-center rounded-xl border border-cool bg-cosmic-800/70 text-ink-secondary transition-colors hover:border-cool-hover hover:text-ink-primary'
          >
            <svg viewBox='0 0 24 24' class='h-5 w-5' set:html={githubIcon}
            ></svg>
          </a>
          <a
            href='//www.linkedin.com/in/orenFarhi/'
            target='_blank'
            rel='noopener noreferrer'
            aria-label='LinkedIn'
            class='flex h-11 w-11 items-center justify-center rounded-xl border border-cool bg-cosmic-800/70 text-ink-secondary transition-colors hover:border-cool-hover hover:text-ink-primary'
          >
            <svg viewBox='0 0 24 24' class='h-5 w-5' set:html={linkedinIcon}
            ></svg>
          </a>
          <a
            href='/contact/'
            aria-label='Email'
            class='flex h-11 w-11 items-center justify-center rounded-xl border border-cool bg-cosmic-800/70 text-ink-secondary transition-colors hover:border-cool-hover hover:text-ink-primary'
          >
            <svg
              viewBox='0 0 24 24'
              class='h-5 w-5'
              fill='none'
              set:html={mailIcon}></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
